rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedWork() {
   return request.auth != null && request.auth.token.email_verified == true
    && request.auth.token.firebase.sign_in_provider == 'google.com'
    && request.auth.token.email is string
    && !request.auth.token.email.matches('.*@gmail[.]com$')
    && !request.auth.token.email.matches('.*@googlemail[.]com$');
  }
  function memberPath(org) {
   return /databases/$(database)/documents/organizations/$(org)/members/$(request.auth.uid);
  }
  function active(org) {
   return signedWork() && exists(memberPath(org))
    && get(memberPath(org)).data.active == true
    && get(memberPath(org)).data.email == request.auth.token.email;
  }
  function hr(org) {
   return active(org) && get(memberPath(org)).data.role in ['hr','admin'];
  }
  function reviewPath(org,reviewId) {
   return /databases/$(database)/documents/organizations/$(org)/reviews/$(reviewId);
  }
  function submissionPath(org,reviewId,uid) {
   return /databases/$(database)/documents/organizations/$(org)/reviews/$(reviewId)/submissions/$(uid);
  }
  function participant(org,reviewId) {
   return active(org) && exists(reviewPath(org,reviewId))
    && request.auth.uid in [
      get(reviewPath(org,reviewId)).data.employeeUid,
      get(reviewPath(org,reviewId)).data.managerUid
    ];
  }
  function openReviewParticipant(org,reviewId,uid) {
   let review = get(reviewPath(org,reviewId)).data;
   return review.status == 'open' && uid in [review.employeeUid,review.managerUid];
  }
  function paired(org,reviewId) {
   let r = get(reviewPath(org,reviewId)).data;
   return exists(submissionPath(org,reviewId,r.employeeUid))
    && exists(submissionPath(org,reviewId,r.managerUid))
    && get(submissionPath(org,reviewId,r.employeeUid)).data.submitted == true
    && get(submissionPath(org,reviewId,r.managerUid)).data.submitted == true;
  }
  function scopedManager(org,review) {
   let member = get(memberPath(org)).data;
   let scope = member.get('reviewEmployeeUids', []);
   return member.role == 'manager' && scope is list
    && review.status == 'finalized' && review.employeeUid in scope;
  }
  function scopedSubmission(org,reviewId,uid) {
   let review = get(reviewPath(org,reviewId)).data;
   return active(org) && scopedManager(org,review)
    && uid in [review.employeeUid,review.managerUid] && paired(org,reviewId);
  }
  function validRatingFields(rating,minEvidence,scores) {
   let score = rating.score;
   let evidence = rating.evidence;
   let evidenceSize = evidence.size();
   // The two required fields and exact size exclude additional fields.
   return [
    rating is map,
    rating.size() == 2,
    score is int,
    score in scores,
    evidence is string,
    evidenceSize <= 2000,
    evidenceSize >= minEvidence
   ].hasOnly([true]);
  }
  // Group the rating checks to keep all 16 within the rules evaluation limit.
  function validSubmission(uid) {
   let submission = request.resource.data;
   let ratings = submission.ratings;
   let submitted = submission.submitted;
   let minEvidence = submitted ? 12 : 0;
   let scores = [0,1,2,3,4];
   // The four required fields and exact size exclude additional fields.
   return submission.size() == 4
    && submission.authorUid == uid
    && submitted is bool
    && submission.updatedAt == request.time
    && ratings is map
    && ratings.keys().hasOnly(['comprehension','evaluation','generation','reframing','metacognition','observation','execution','experimentation','construction','transformation','honesty','accountability','fairness','courage','discernment','stewardship'])
    && (!submitted || ratings.size() >= 3)
    && [
      ('comprehension' in ratings ? validRatingFields(ratings.comprehension,minEvidence,scores) : true),
      ('evaluation' in ratings ? validRatingFields(ratings.evaluation,minEvidence,scores) : true),
      ('generation' in ratings ? validRatingFields(ratings.generation,minEvidence,scores) : true),
      ('reframing' in ratings ? validRatingFields(ratings.reframing,minEvidence,scores) : true),
      ('metacognition' in ratings ? validRatingFields(ratings.metacognition,minEvidence,scores) : true),
      ('observation' in ratings ? validRatingFields(ratings.observation,minEvidence,scores) : true),
      ('execution' in ratings ? validRatingFields(ratings.execution,minEvidence,scores) : true),
      ('experimentation' in ratings ? validRatingFields(ratings.experimentation,minEvidence,scores) : true),
      ('construction' in ratings ? validRatingFields(ratings.construction,minEvidence,scores) : true),
      ('transformation' in ratings ? validRatingFields(ratings.transformation,minEvidence,scores) : true),
      ('honesty' in ratings ? validRatingFields(ratings.honesty,minEvidence,scores) : true),
      ('accountability' in ratings ? validRatingFields(ratings.accountability,minEvidence,scores) : true),
      ('fairness' in ratings ? validRatingFields(ratings.fairness,minEvidence,scores) : true),
      ('courage' in ratings ? validRatingFields(ratings.courage,minEvidence,scores) : true),
      ('discernment' in ratings ? validRatingFields(ratings.discernment,minEvidence,scores) : true),
      ('stewardship' in ratings ? validRatingFields(ratings.stewardship,minEvidence,scores) : true)
    ].hasOnly([true]);
  }
  match /organizations/{org}/members/{uid} {
   allow get: if active(org) && (uid == request.auth.uid || hr(org));
   allow list: if hr(org);
   allow create, update, delete: if false;
  }
  match /organizations/{org}/reviews/{reviewId} {
   allow get, list: if active(org) && (hr(org)
    || request.auth.uid == resource.data.employeeUid
    || request.auth.uid == resource.data.managerUid
    || scopedManager(org,resource.data));
   allow create: if hr(org)
    && request.resource.data.keys().hasOnly(['employeeUid','managerUid','cycle','status','createdBy','createdAt'])
    && request.resource.data.keys().hasAll(['employeeUid','managerUid','cycle','status','createdBy','createdAt'])
    && request.resource.data.employeeUid is string
    && request.resource.data.managerUid is string
    && request.resource.data.employeeUid != request.resource.data.managerUid
    && exists(/databases/$(database)/documents/organizations/$(org)/members/$(request.resource.data.employeeUid))
    && exists(/databases/$(database)/documents/organizations/$(org)/members/$(request.resource.data.managerUid))
    && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.resource.data.employeeUid)).data.active == true
    && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.resource.data.managerUid)).data.active == true
    && get(/databases/$(database)/documents/organizations/$(org)/members/$(request.resource.data.managerUid)).data.role in ['manager','hr','admin']
    && request.resource.data.cycle is string
    && request.resource.data.cycle.size() >= 3 && request.resource.data.cycle.size() <= 100
    && request.resource.data.status == 'open'
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt == request.time;
   allow update: if hr(org)
    && resource.data.status == 'open'
    && request.resource.data.status == 'finalized'
    && request.resource.data.finalizedBy == request.auth.uid
    && request.resource.data.finalizedAt == request.time
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','finalizedBy','finalizedAt'])
    && paired(org,reviewId);
   allow delete: if false;
   match /submissions/{uid} {
    allow get: if (participant(org,reviewId) && uid == request.auth.uid)
     || ((participant(org,reviewId) || hr(org)) && paired(org,reviewId))
     || scopedSubmission(org,reviewId,uid);
    allow list: if false;
    allow create, update: if active(org) && uid == request.auth.uid
     && (resource == null || resource.data.submitted == false)
     && openReviewParticipant(org,reviewId,uid)
     && validSubmission(uid);
    allow delete: if false;
   }
   match /discussion/{commentId} {
    allow get, list: if (participant(org,reviewId) || hr(org)) && paired(org,reviewId);
    allow create: if (participant(org,reviewId) || hr(org))
     && paired(org,reviewId)
     && request.resource.data.keys().hasOnly(['authorUid','text','createdAt'])
     && request.resource.data.keys().hasAll(['authorUid','text','createdAt'])
     && request.resource.data.authorUid == request.auth.uid
     && request.resource.data.text is string
     && request.resource.data.text.size() >= 10 && request.resource.data.text.size() <= 2500
     && request.resource.data.createdAt == request.time;
    allow update, delete: if false;
   }
  }
  // Everything else is private and inaccessible from the browser.
  match /{path=**} { allow read, write: if false; }
 }
}
